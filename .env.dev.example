# Development-only TradeTally configuration.
# Copy to .env.dev. These placeholder values are intentionally non-production;
# generate different local values before loading representative data.

DB_USER=tradetally_dev
DB_PASSWORD=development-only-not-a-production-password
DB_NAME=tradetally_dev
JWT_SECRET=development-only-not-a-production-jwt-secret-change-me
BROKER_ENCRYPTION_KEY=development-only-not-a-production-encryption-key-change-me

NODE_ENV=development
TZ=America/Bogota
VITE_API_URL=/api
FRONTEND_URL=http://localhost:8081
CORS_ORIGINS=http://localhost:8081,http://localhost:5173
INSTANCE_NAME=TradeTally Local Development
INSTANCE_URL=http://localhost:8081
APP_URL=http://localhost:8081
BASE_URL=http://localhost:8081

# Local development must not create external side effects.
BILLING_ENABLED=false
FEATURES_BILLING_ENABLED=false
ENABLE_BROKER_SYNC_SCHEDULER=false
ENABLE_TRIAL_EMAILS=false
ENABLE_RETENTION_EMAILS=false
ENABLE_BACKUP_SCHEDULER=false
ENABLE_PRICE_MONITORING=false
ENABLE_TRADE_ENRICHMENT=false
ENABLE_JOB_RECOVERY=false
ENABLE_OPTIONS_SCHEDULER=false
ENABLE_CATEGORY_SCHEDULER=false
ENABLE_DIVIDEND_SCHEDULER=false
ENABLE_EARNINGS_SCHEDULER=false
ENABLE_NEWS_SCHEDULER=false
ENABLE_DASHBOARD_CACHE_WARMER=false
ENABLE_STOCK_SCANNER=false
